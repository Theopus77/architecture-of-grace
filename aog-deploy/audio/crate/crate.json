  "verses": [
   {
    "ref": "Leviticus 20:7",
    "ref_es": "Levítico 20:7",
    "at": 0.35,
    "text": "Santificaos, pues, y sed santos, porque yo Jehová soy vuestro Dios."
   },
   {
    "ref": "Psalm 51:10",
    "ref_es": "Salmo 51:10",
    "at": 7.19,
    "text": "Crea en mí, oh Dios, un corazón limpio; Y renueva un espíritu recto dentro de mí."
   },
   {
    "ref": "Ezekiel 36:26",
    "ref_es": "Ezequiel 36:26",
    "at": 14.67,
    "text": "Y os daré corazón nuevo, y pondré espíritu nuevo dentro de vosotros; y quitaré de vuestra carne el corazón de piedra, y os daré corazón de carne."
   },
   {
    "ref": "John 17:17",
    "ref_es": "Juan 17:17",
    "at": 26.82,
    "text": "Santifícalos en tu verdad: tu palabra es verdad."
   },
   {
    "ref": "1 Thessalonians 4:7",
    "ref_es": "1 Tesalonicenses 4:7",
    "at": 31.6,
    "text": "Porque no nos ha llamado Dios á inmundicia, sino á santificación."
   },
   {
    "ref": "1 Thessalonians 5:23",
    "ref_es": "1 Tesalonicenses 5:23",
    "at": 37.12,
    "text": "Y el Dios de paz os santifique en todo; para que vuestro espíritu y alma y cuerpo sea guardado entero sin reprensión para la venida de nuestro Señor Jesucristo."
   },
   {
    "ref": "Hebrews 10:10",
    "ref_es": "Hebreos 10:10",
    "at": 50.74,
    "text": "En la cual voluntad somos santificados por la ofrenda del cuerpo de Jesucristo hecha una sola vez."
   },
   {
    "ref": "1 Peter 1:16",
    "ref_es": "1 Pedro 1:16",
    "at": 59.61,
    "text": "Porque escrito está: Sed santos, porque yo soy santo."
   }
  ],
  "phrases": [
