 {
  "file": "17-el-unico-camino.mp3",
  "title": "The Only Way in Spanish",
  "title_es": "El único camino",
  "bpm": 0,
  "kind": "scripture",
  "version": "RV 1909",
  "style": "Scripture (Reina-Valera)",
  "style_es": "Escritura (Reina-Valera)",
  "bars": 0,
  "seconds": 69.4,
  "bytes": 555704,
  "line": "Jesus is the only way to the Father, read in Spanish: Isaiah to John.",
  "line_es": "Jesús es el único camino al Padre: ocho versículos de Isaías a Juan.",
  "verses": [
   {
    "ref": "Isaiah 43:11",
    "ref_es": "Isaías 43:11",
    "at": 0.35,
    "text": "Yo, yo Jehová, y fuera de mí no hay quien salve."
   },
   {
    "ref": "Isaiah 45:22",
    "ref_es": "Isaías 45:22",
    "at": 5.19,
    "text": "Mirad á mí, y sed salvos, todos los términos de la tierra: porque yo soy Dios, y no hay más."
   },
   {
    "ref": "Isaiah 53:5",
    "ref_es": "Isaías 53:5",
    "at": 12.43,
    "text": "Mas él herido fué por nuestras rebeliones, molido por nuestros pecados: el castigo de nuestra paz sobre él; y por su llaga fuimos nosotros curados."
   },
   {
    "ref": "John 14:6",
    "ref_es": "Juan 14:6",
    "at": 22.59,
